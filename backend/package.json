{
  "name": "campusbridge-api",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test:unit": "node --test tests/validate.test.js tests/rateLimit.test.js",
    "test:api": "node --test tests/api.test.js && node --test tests/learning.test.js",
    "test": "npm run test:unit && npm run test:api",
    "demo:reset": "node scripts/reset-demo.js",
    "set-role": "node scripts/set-role.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  }
}
