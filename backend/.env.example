# Copy this file to ".env" (same folder) and fill in your own values.
# NEVER share or commit the real .env file.

# API port
PORT=5000

# Your local PostgreSQL connection. Replace YOUR_POSTGRES_PASSWORD with the password you chose when installing PostgreSQL.
# If your password has special characters (@ : / # %), URL-encode them (e.g. @ becomes %40).
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/campusbridge

# A long random secret used to sign login tokens (at least 32 characters).
# Generate one in PowerShell with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Optional: how long a login stays valid (default 7d)
# JWT_EXPIRES_IN=7d

# Browser address(es) allowed to call this API, comma-separated. Vite uses 5173 by default.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Optional: only if the API runs behind a reverse proxy (Nginx, Render, ...). Number of proxies, e.g. 1.
# Leave it unset when running locally.
# TRUST_PROXY=1

# Optional: create three demo accounts (student, instructor, coordinator) so every role can be demonstrated.
# Their password is PUBLIC (Demo12345), so this is ignored when NODE_ENV=production. See README.
# SEED_DEMO_ACCOUNTS=true
